#!/usr/bin/env bash
set -euo pipefail

limit="${1:-300}"
status=0
while IFS= read -r file; do
  lines="$(wc -l < "$file")"
  if (( lines > limit )); then
    echo "$file has $lines lines, the limit is $limit" >&2
    status=1
  fi
done < <(find crates -name '*.rs' -not -path '*/target/*')
exit "$status"
